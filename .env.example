# Volleymetrics MCP Configuration

# Option 1 (Recommended): Interactive pop-up browser login
# Say "Log me into Volleymetrics" or call `login_to_volleymetrics` in your AI chat.
# Your credentials and session tokens will be securely saved in ~/.volleymetrics_mcp/auth_state.json
# and the OS Keychain without storing passwords here.

# Option 2 (Direct Token / Automated Headless Refresh):
# VOLLEYMETRICS_EMAIL=coach@example.com
# VOLLEYMETRICS_PASSWORD=your_password_here

# Optional: Pre-configured Bearer token or cookie
# VOLLEYMETRICS_TOKEN=your_jwt_access_token_here

# Active Team Identifier (auto-detected if omitted)
# VOLLEYMETRICS_TEAM_ID=12345

# API Configuration (Defaults to production)
VOLLEYMETRICS_API_URL=https://api.volleymetrics.hudl.com
VOLLEYMETRICS_PORTAL_URL=https://portal.volleymetrics.hudl.com
VOLLEYMETRICS_TIMEOUT=20.0
